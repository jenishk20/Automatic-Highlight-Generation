import os
import cv2
import json
import torch
import numpy as np
import torchvision.models.video as video_models
import torch.nn as nn
from pathlib import Path
from torch.nn.functional import softmax
import albumentations as A
from albumentations.pytorch import ToTensorV2
from moviepy.editor import VideoFileClip, concatenate_videoclips
import matplotlib.pyplot as plt
from collections import Counter


device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

class R3DClassifier(nn.Module):
    def __init__(self, num_classes):
        super(R3DClassifier, self).__init__()
        self.model = video_models.r3d_18(weights=None)
        in_features = self.model.fc.in_features
        self.model.fc = nn.Sequential(
            nn.Dropout(0.3),
            nn.Linear(in_features, num_classes)
        )

    def forward(self, x):
        return self.model(x)

def load_r3d_model(model_path, num_classes=9, device='cuda'):
    print("📦 Loading trained R3D model...")
    model = R3DClassifier(num_classes)
    model.load_state_dict(torch.load(model_path, map_location=device))
    return model.to(device).eval()

def split_video_into_clips(video_path, clip_len_sec=5, stride_sec=2, out_dir="clips_1", fps=30):
    print("🎬 Splitting video into clips...")
    cap = cv2.VideoCapture(video_path)
    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    actual_fps = int(cap.get(cv2.CAP_PROP_FPS) or fps)
    clip_len = clip_len_sec * actual_fps
    stride = stride_sec * actual_fps
    os.makedirs(out_dir, exist_ok=True)
    count, timestamps = 0, []

    for start in range(0, total_frames - clip_len, stride):
        cap.set(cv2.CAP_PROP_POS_FRAMES, start)
        frames = [cap.read()[1] for _ in range(clip_len) if cap.read()[0]]
        if len(frames) == clip_len:
            out_path = os.path.join(out_dir, f"clip_{count}.mp4")
            h, w, _ = frames[0].shape
            writer = cv2.VideoWriter(out_path, cv2.VideoWriter_fourcc(*'mp4v'), actual_fps, (w, h))
            for f in frames: writer.write(f)
            writer.release()
            timestamps.append((out_path, start / actual_fps))
            count += 1
    cap.release()
    print(f"✅ Generated {count} clips.")
    return timestamps

transform = A.Compose([
    A.Resize(224, 224),
    A.Normalize(mean=[0.43216, 0.394666, 0.37645], std=[0.22803, 0.22145, 0.216989]),
    ToTensorV2()
])

def load_clip_frames(path, num_frames=32, device='cuda'):
    cap = cv2.VideoCapture(str(path))
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    idxs = np.linspace(0, total - 1, num_frames, dtype=int)
    frames = []
    for idx in idxs:
        cap.set(cv2.CAP_PROP_POS_FRAMES, idx)
        ret, frame = cap.read()
        if not ret: continue
        frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        frame = transform(image=frame)['image']
        frames.append(frame)
    cap.release()
    if len(frames) < num_frames:
        return None
    return torch.stack(frames).permute(1, 0, 2, 3).unsqueeze(0).float().to(device)


def run_clip_predictions(timestamps, model, class_names, device='cuda'):
    print("🧠 Running model predictions on each clip...")
    predictions = []
    for clip_path, start_time in timestamps:
        clip_tensor = load_clip_frames(clip_path, device=device)
        if clip_tensor is None: continue
        with torch.no_grad():
            probs = softmax(model(clip_tensor), dim=1)[0]
        top_class = torch.argmax(probs).item()
        confidence = probs[top_class].item()
        predictions.append({
            'path': str(clip_path),
            'label': class_names[top_class],
            'confidence': confidence,
            'start_time': start_time
        })
    print(f"✅ Completed inference on {len(predictions)} clips.")
    return predictions


def select_top_clips(predictions, target_duration_sec=300, json_out="selected_clips.json"):
    print("🎯 Selecting top clips for highlight reel...")
    sorted_preds = sorted(predictions, key=lambda x: (-x['confidence'], x['start_time']))
    selected, total_time, chart_labels = [], 0, []
    clip_metadata = []

    for pred in sorted_preds:
        clip = VideoFileClip(pred['path'])
        duration = clip.duration
        if total_time + duration > target_duration_sec: break
        selected.append((clip, pred['start_time']))
        chart_labels.append(pred['label'])
        clip_metadata.append({
            "path": pred['path'],
            "label": pred['label'],
            "confidence": round(pred['confidence'], 4),
            "duration": round(duration, 2),
            "start_time": round(pred['start_time'], 2)
        })
        total_time += duration

    with open(json_out, "w") as f:
        json.dump(clip_metadata, f, indent=2)
    print(f"📄 Saved metadata for {len(selected)} clips to {json_out}")

    # Bar chart
    label_counts = Counter(chart_labels)
    plt.figure(figsize=(8, 4))
    plt.bar(label_counts.keys(), label_counts.values())
    plt.title("Top Predicted Labels in Highlight")
    plt.xticks(rotation=45)
    plt.ylabel("Clip Count")
    plt.tight_layout()
    plt.grid(True)
    plt.show()

    # Sort by time and merge
    print("🎞️ Generating final highlight reel...")
    selected.sort(key=lambda x: x[1])
    final_clips = [clip for clip, _ in selected]
    final = concatenate_videoclips(final_clips, method="compose")
    final.write_videofile("highlight_reel.mp4")
    print("✅ highlight_reel.mp4 ready!")


def generate_highlight_reel(input_video_path, model_path, class_names, device='cuda'):
    model = load_r3d_model(model_path, num_classes=len(class_names), device=device)
    timestamps = split_video_into_clips(input_video_path)
    predictions = run_clip_predictions(timestamps, model, class_names, device=device)
    select_top_clips(predictions)

generate_highlight_reel(
    input_video_path="/kaggle/working/converted_video_part_2.mp4",
    model_path="/kaggle/input/best-model/best_model_config2.pth",
    class_names=["Corner", "Foul", "Goal", "Kick-off", "Penalty", "Red card", "Shots off target", "Shots on target", "Yellow card"],
    device=device
)
